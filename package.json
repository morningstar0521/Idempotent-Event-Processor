{
  "name": "idempotent-event-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev:api": "tsx src/bin/api.ts",
    "dev:relay": "tsx src/bin/relay.ts",
    "dev:worker": "tsx src/bin/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "migrate": "tsx scripts/migrate.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:chaos": "vitest run --project chaos",
    "test:chaos:full": "node -e \"console.error('not implemented yet'); process.exit(1)\"",
    "load": "node -e \"console.error('not implemented yet'); process.exit(1)\"",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "prom-client": "^15.1.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.15.5",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

